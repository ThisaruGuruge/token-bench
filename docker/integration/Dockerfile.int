# Integration variant of one arm image: the Ballerina skill (grammar-neutral
# patch) as a Claude Code plugin, and the scenario's libraries pre-pulled into
# the image's own Ballerina home, identically for both arms.
ARG ARM_IMAGE
FROM ${ARM_IMAGE}
COPY --chown=node:node bench-plugin /opt/bench-plugin
COPY --chown=node:node prepull /tmp/prepull
RUN cd /tmp/prepull && bal build > /tmp/prepull.log 2>&1 || (cat /tmp/prepull.log; exit 1); \
    cd / && rm -rf /tmp/prepull /tmp/prepull.log
LABEL org.token-bench.integration="lead-routing" org.token-bench.skill-patch="ballerina-skill-discover-neutral"
