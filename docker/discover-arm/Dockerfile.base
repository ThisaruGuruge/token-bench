# Base image of the grammar benchmark's container arms: Linux Ballerina, Claude
# Code and the logging bal wrapper. Nothing from the host besides the files in
# this build context (the Ballerina .deb, the wrapper binary, the entrypoint).
FROM node:22.22.2-bookworm-slim

ARG CLAUDE_CODE_VERSION
ARG BAL_VERSION

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates bash procps \
 && rm -rf /var/lib/apt/lists/*

COPY ballerina.deb /tmp/ballerina.deb
# The launcher's own commands (bal version, bal help) run `java` from PATH when
# it does not know the bundled JRE's version; give it the bundled one.
RUN dpkg -i /tmp/ballerina.deb && rm /tmp/ballerina.deb \
 && java_bin="$(ls -d /usr/lib/ballerina/dependencies/jdk-*-jre/bin/java | head -n 1)" \
 && test -x "$java_bin" && ln -s "$java_bin" /usr/local/bin/java

RUN npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" && npm cache clean --force

# The wrapper takes the place of bal on PATH; the real launcher stays where the
# package put it and is reached only through the wrapper.
COPY bal-calllog /usr/local/bin/bal-calllog
RUN set -e; real="$(readlink -f "$(command -v bal)")"; \
    test -x "$real"; \
    for link in $(which -a bal); do rm -f "$link"; done; \
    ln -s /usr/local/bin/bal-calllog /usr/local/bin/bal; \
    printf '%s\n' "$real" > /etc/token-bench-real-bal; \
    test "$(which -a bal)" = "/usr/local/bin/bal"
COPY entrypoint.sh /usr/local/bin/bench-entrypoint

USER node
WORKDIR /work
RUN mkdir -p /home/node/.ballerina && bal version

ENV DISABLE_AUTOUPDATER=1
LABEL org.token-bench.claude-code="${CLAUDE_CODE_VERSION}" \
      org.token-bench.ballerina="${BAL_VERSION}"
ENTRYPOINT ["/usr/local/bin/bench-entrypoint"]
